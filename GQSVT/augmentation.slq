import block_encodings.symtwobytwo;
import GQSVT.func_approx;
import GQSVT.gqsp_angles;
import GQSVT.matrix_poly;

def proj_not[n:!ℕ](k:!ℕ,const control:𝔹^n,target:𝔹^1) qfree{
    if control=(k as uint[n] as 𝔹^n){target[0] := X(target[0]);} 
    return target;
}

def G[n:!ℕ,m:!ℕ](anc:𝔹^(m+1),qs:𝔹^n,const f:𝔹^m × 𝔹^n → mfree 𝔹^m × 𝔹^n,const b:𝔹^n → mfree 𝔹^n){
    (flag:𝔹^1)~(anc:𝔹^m) := anc;
    (anc,qs) := f(anc,qs);
    with {b(qs):=qs}do{flag := proj_not(0:!ℕ,qs,flag);}
    return (flag~anc,qs);
}

def f_aug[n:!ℕ,m:!ℕ](t:!ℝ,e:!ℕ,anc:𝔹^(m+1),qs:𝔹^n,const f:𝔹^m × 𝔹^n → mfree 𝔹^m × 𝔹^n) mfree{
    (flag:𝔹^1)~(anc:𝔹^m) := anc;
    flag := proj_not(e,qs,flag);
    if !flag[0]{(anc,qs) := f(anc,qs);}
    if flag[0]{anc[0] := rotY(-2*acos(1/t),anc[0]);}
    flag := proj_not(e,qs,flag);
    return (flag~anc,qs);
}

def b_aug[n:!ℕ](e:!ℕ,const b:𝔹^n → mfree 𝔹^n,flag:𝔹^1,qs:𝔹^n) mfree{
    flag[0] := H(flag[0]);
    if !flag[0]{qs := b(qs);}
    if flag[0]{for j in [0..n){if (e as !uint[n])[j]{qs[j] := X(qs[j]);}}}
    flag := proj_not(e,qs,flag);
    return (flag,qs);
}

def G_aug[n:!ℕ,m:!ℕ](t:!ℝ,e:!ℕ,anc:𝔹^(m+2),qs:𝔹^n,const f:𝔹^m × 𝔹^n → mfree 𝔹^m × 𝔹^n,const b:𝔹^n → mfree 𝔹^n) mfree{
    (flag:𝔹^1)~(anc:𝔹^(m+1)) := anc;
    (anc,qs) := f_aug(t,e,anc,qs,f);
    (anc:𝔹^m)~(ext:𝔹^1) := anc;
    with {b_aug(e,b,ext,qs) := (ext,qs)}do{if !ext[0]{flag := proj_not(0:!ℕ,qs,flag);}}
    return (flag~anc~ext,qs);
}

def kernel_aug[n:!ℕ,m:!ℕ,d:!ℕ](t:!ℝ,e:!ℕ,angles:!ℝ^(d+1)×!ℝ^(d+1)×!ℝ,anc:𝔹^(m+5),qs:𝔹^n,const f:𝔹^m × 𝔹^n → mfree 𝔹^m × 𝔹^n,const b:𝔹^n → mfree 𝔹^n) mfree{
    def Gt(ancilla:𝔹^(m+2),qs:𝔹^n){return G_aug(t,e,ancilla,qs,f,b);}
    (flag:𝔹^1)~(anc:𝔹^(m+4)) := anc;
    θs:=angles[0];φs:=angles[1];λ:=angles[2];
    with {anc[1] := X(anc[1])}do{(anc,qs) := gqsvt[0][d](θs,φs,λ)(Gt)(anc,qs);}
    if anc=vector(m+4,0:𝔹){flag := proj_not(e,qs,flag);}
    return (flag~anc,qs);
}

def qlss[n:!ℕ,m:!ℕ](L:!ℝ,R:!ℝ,κ:!ℝ,η:!ℝ,ϵ:!ℝ,const f:𝔹^m × 𝔹^n → mfree 𝔹^m × 𝔹^n,const b:𝔹^n → mfree 𝔹^n){
    def padded(ancilla:𝔹^(m+1),xs:𝔹^(n+1)) mfree{
        (flag:𝔹^1)~(anc:𝔹^m) := ancilla;(xs:𝔹^n)~(ext:𝔹^1) := xs;
        if anc=vector(m,0:𝔹){flag[0] := X(flag[0]);}
        (anc,xs) := f(anc,xs); 
        if !ext[0]{flag[0] := X(flag[0]);}
        return (flag~anc,xs~ext);
    }
    def padded_b(xs:𝔹^(n+1)) mfree{(xs:𝔹^n)~(ext:𝔹^1) := xs; if !ext[0]{xs := b(xs);} return xs~ext;}
    def G_nt(ancilla:𝔹^(m+2),xs:𝔹^(n+1)){return G[n+1,m+1](ancilla,xs,padded,padded_b);}
    μ := (η/(1-η))*sqrt(3+2*log((R^2+L^2)/(2*L^2)));
    η_kp := min(1/2,(ϵ*sqrt(1-μ^2))/(μ*sqrt(1-ϵ^2)));
    k := ceil(κ*log(2/η)/2) coerce !ℕ; Δ := 1/κ;
    l := ceil(κ*log(2/η_kp)/2) coerce !ℕ;
    p_kr := normalize_polynomial[2*k](kernel_reflection(k,Δ));
    q_kr := complement[2*k](p_kr,1e-8);
    angles_kr := gqsp_compute_angles[2*k](p_kr,q_kr);
    p_kp := normalize_polynomial[2*l](eigen_filt(l,Δ));
    q_kp := complement[2*l](p_kp,1e-8);
    (θs,φs,λ) := gqsp_compute_angles[2*l](p_kp,q_kp);
    accepted := 0:!𝔹; xs := 0:uint[n] as 𝔹^n;
    while !accepted{
        measure(xs);
        solved := 0:!𝔹; ys := 0:uint[n+1] as 𝔹^(n+1);
        while !solved{
            flagged := 0:!𝔹;
            while !flagged{
                measure(ys); ys := 2^n as uint[n+1] as 𝔹^(n+1);
                anc := 0:uint[m+6] as 𝔹^(m+6);
                u := 0:!ℝ;
                for i in (64..-1..1]{u += measure(H(0))*2^-i;}
                τ := log(L)-1/2+(log(R)-log(L)+1)*u;
                t := exp(min(log(R),max(log(L),τ)));
                (anc,ys) := kernel_aug[n+1,m+1,2*k](t,2^n,angles_kr,anc,ys,padded,padded_b);
                r := measure(anc) as !uint[m+6];
                if r=0{flagged = 1:!𝔹;}
            }
            anc := 2:uint[m+4] as 𝔹^(m+4);
            (anc,ys) := gqsvt[0][2*l](θs,φs,λ)(G_nt)(anc,ys);
            anc[1] := X(anc[1]);
            r := measure(anc) as !uint[m+4];
            if r=0{solved = 1:!𝔹;}
        }
        (xs:𝔹^n)~(ext:𝔹^1) := ys;
        r := measure(ext) as !uint[1];
        if r=0{accepted = 1:!𝔹;}
    }
    return xs;
}

def main(){
    def b(xs:𝔹^1) mfree{
        xs[0] := X(xs[0]);
        return xs;
    }
    def matrix(anc:𝔹^2,xs:𝔹^1) mfree{
        return twosym_block(anc,xs,1,-1/3);
    }
    return qlss[1,2](2,3,3,2e-2,1e-6,matrix,b);
}
