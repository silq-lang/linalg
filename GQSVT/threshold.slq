import GQSVT.gqsp_angles;
import GQSVT.matrix_poly;
import GQSVT.func_approx;
import block_encodings.block_subroutines;
import block_encodings.symtwobytwo;

def eigenvalue_threshold[n:!ℕ,m:!ℕ](const f:𝔹^m × 𝔹^n → mfree 𝔹^m × 𝔹^n)(ancilla:𝔹^(m+1),xs:𝔹^n)(ζ:!ℝ,Δ:!ℝ,δ:!ℝ,λt:!ℝ,α:!ℝ){
    for j in [0..n){xs[j] := H(xs[j]);}
    N := floor((315/(32*ζ^2))*log(1/δ)) coerce !ℕ;
    d := 2*floor(α*log(4/ζ)/(2*Δ)) coerce !ℕ;
    p := rect_func(d,(α/Δ/sqrt(2))*sqrt(log(32/π/ζ^2)),λt/α);
    p := chebyshev_coef[d sub 1](p);
    scale := polynomial_normalization_scale[d sub 1](p);
    N = max(N,ceil(4*N/scale^2)) coerce !ℕ;
    print(d,(α/Δ/sqrt(2))*sqrt(log(32/π/ζ^2)),N);
    p := normalize_polynomial[d sub 1](p);
    q := complement[d sub 1](p,1e-8);
    assert(is_complement[num_samples(d sub 1,1e-8)][d sub 1](p,q,1e-8));
    angles := gqsp_compute_angles[d sub 1](p,q);
    θs:=angles[0];φs:=angles[1];λ:=angles[2];
    count := 0:!ℕ;
    for j in [0..N){
        (anc,qs) := dup((ancilla,xs));
        flag := H(0:𝔹);
        if flag{
            (anc,qs) := gqet[0][d sub 1](θs,φs,λ)(f)(anc,qs);
        }
        flag := H(flag);
        r := measure(flag);
        if !r{count += 1;}
        measure(anc,qs);
        print(j,r)
    }
    mean := (2*count/N-1)/scale;
    c1 := abs(mean - (ζ^2)*(1-ζ/4));
    c2 := abs(mean - (ζ^2)/32);
    print(c1,c2);
    measure(ancilla,xs);
    return (c1<c2);
}

def eigenstate_filtering[n:!ℕ,m:!ℕ](const f:𝔹^m × 𝔹^n → mfree 𝔹^m × 𝔹^n,anc:𝔹^(m+3),qs:𝔹^n,k:!ℕ,Δ:!ℝ,λf:!ℂ,α:!ℝ){
    def det_H(ancilla:𝔹^(m+1),xs:𝔹^n){
        (flag:𝔹^1)~(ancilla:𝔹^m) := ancilla;
        θ := 2*atan(sqrt(α/cabs(λf)));
        flag[0] := rotY(θ,flag[0]);
        flag[0] := rotZ(-carg(-λf),flag[0]);
        if flag[0]{(ancilla,xs) := f(ancilla,xs);}
        flag[0] := rotY(-θ,flag[0]);
        phase(carg(-λf)/2);
        return (flag~ancilla,xs);
    }
    p := eigen_filt(k,Δ/(2*α));
    p := normalize_polynomial[2*k](p);
    q := complement[2*k](p,1e-8);
    assert(is_complement[num_samples(2*k+1,1e-8)][2*k](p,q,1e-8));
    angles := gqsp_compute_angles[2*k](p,q);
    θs:=angles[0];φs:=angles[1];λ:=angles[2];
    return gqsvt[0][2*k](θs,φs,λ)(det_H)(anc,qs);
}

def singular_vector_trans[n:!ℕ,m:!ℕ](const f:𝔹^m × 𝔹^n → mfree 𝔹^m × 𝔹^n,anc:𝔹^(m+2),qs:𝔹^n,ϵ:!ℝ,κ:!ℝ){
    d := floor(2*log(1/ϵ)/κ) coerce !ℕ;
    k := (sqrt(2)/κ)*sqrt(log(2/π/ϵ^2));
    p := sign_func(d,k,0) coerce !ℂ^(d+1);
    p := normalize_polynomial[d](chebyshev_coef[d](p));
    q := complement[d](p,1e-8);
    assert(is_complement[num_samples(d,1e-8)][d](p,q,1e-8));
    angles := gqsp_compute_angles[d](p,q);
    θs:=angles[0];φs:=angles[1];λ:=angles[2];
    return gqsvt[0][d](θs,φs,λ)(f)(anc,qs);
}


def main(){
    def twosym(anc:𝔹^2,xs:𝔹^1){
        return twosym_block(anc,xs,1,0.35);
    }
    qs := 1:uint[1] as 𝔹^1;
    //return eigenvalue_threshold[2,1](non_uni_diag[2])(0:uint[2] as 𝔹^2,0:uint[2] as 𝔹^2)(1e-1,0.07,5e-2,0.1,max(v));  // yields false
    (anc,qs) := eigenstate_filtering[1,2](twosym,0:uint[5] as 𝔹^5,qs,14,0.7,0.65,2);
    //(anc,qs) := singular_vector_trans[2,1](non_uni_diag[2],2:uint[3] as 𝔹^3,qs,1e-4,0.8);
    return (anc,qs);
}
