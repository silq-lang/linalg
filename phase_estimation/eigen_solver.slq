import arithmetic.shift;
import GQSVT.augmentation;
import block_encodings.symtwobytwo;
import phase_estimation.QFT;

def lowshift_pow_p[j:!ℕ][n:!ℕ](qs:𝔹^n) mfree{
    for k in [0..j){if (qs as uint[n])=(2^n sub k sub 1){phase(π);}}
    qs := lowshift_pow[j](qs);
    return qs;
}

def lowshift_block[j:!ℕ][n:!ℕ](anc:𝔹^1,qs:𝔹^n) mfree{
    with anc[0]:=H(anc[0]){
        if !anc[0]{qs := lowshift_pow[j](qs);}
        if anc[0]{qs := lowshift_pow_p[j](qs);}
    }
    return (anc,qs);
}

def pad[m:!ℕ,n:!ℕ,ν:!ℕ](ancilla:𝔹^(m+3),data:𝔹^(n+ν),const f:𝔹^m × 𝔹^n → mfree 𝔹^m × 𝔹^n) mfree{
    (flag1:𝔹^1)~(flag2:𝔹^1)~(shift_anc:𝔹^1)~(anc:𝔹^m) := ancilla;
    (xs:𝔹^n)~(clock:𝔹^ν) := data;
    θ1 := 2*atan(sqrt(1/3)); flag1[0] := rotY(θ1,flag1[0]);
    if !flag1[0]{
        θ2 := 2*atan(sqrt(2)); flag2[0] := rotY(θ2,flag2[0]); flag2[0] := rotZ(π,flag2[0]);
        if !flag2[0]{(shift_anc,clock) := lowshift_block[2][ν](shift_anc,clock);}
        if flag2[0]{(shift_anc,clock) := lowshift_block[1][ν](shift_anc,clock); (anc,xs) := f(anc,xs);}
        flag2[0] := rotY(-θ2,flag2[0]); phase(π/2);
    }
    flag1[0] := rotY(-θ1,flag1[0]);
    return (flag1~flag2~shift_anc~anc,xs~clock);
}

def chebyshev_history_state[ν:!ℕ][m:!ℕ,n:!ℕ](L:!ℝ,R:!ℝ,κ:!ℝ,η:!ℝ,ϵ:!ℝ,const f:𝔹^m × 𝔹^n → mfree 𝔹^m × 𝔹^n,const b:𝔹^n → mfree 𝔹^n){
    assert(ν>=2);
    def history(ancilla:𝔹^(m+3),data:𝔹^(n+ν)) mfree{return pad[m,n,ν](ancilla,data,f);}
    def rhs(data:𝔹^(n+ν)) mfree{
        (xs:𝔹^n)~(clock:𝔹^ν) := data;
        xs := b(xs); clock[1] := H(X(clock[1]));
        return xs~clock;
    }
    data := qlss[n+ν,m+3](L,R,κ,η,ϵ,history,rhs);
    (xs:𝔹^n)~(clock:𝔹^ν) := data;
    return (clock,xs);
}

def eigenvalue_estimator[shots:!ℕ][ν:!ℕ][m:!ℕ,n:!ℕ](α:!ℝ,L:!ℝ,R:!ℝ,κ:!ℝ,η:!ℝ,ϵ:!ℝ,const f:𝔹^m × 𝔹^n → mfree 𝔹^m × 𝔹^n,const b:𝔹^n → mfree 𝔹^n){
    assert(shots>0);
    counts := vector((2^ν div 2)+1,0:!ℕ);
    for j in [0..shots){
        (clock,xs) := chebyshev_history_state[ν][m,n](L,R,κ,η,ϵ,f,b);
        sample := semiclassical_qft[ν](clock);
        measure(xs);
        folded := sample;
        if folded>2^(ν sub 1){folded = 2^ν sub folded;}
        counts[folded] += 1;
    }
    mode := 0:!ℕ;
    for j in [1..(2^ν div 2)+1){if counts[j]>counts[mode]{mode = j;}}
    φ := mode/2^ν as !ℝ;
    return α*cos(2*π*φ);
}

def main(){
    def matrix(anc:𝔹^2,xs:𝔹^1)mfree{return twosym_block(anc,xs,sqrt(2-sqrt(2)),0);}
    def b(xs:𝔹^1)mfree{return xs;}
    return eigenvalue_estimator[3][4][2,1](1/(2*sqrt(2-sqrt(2))),15,16,25,1e-1,5e-2,matrix,b);
}
