import phase_estimation.QPE;

def projector_reflection[n:!ℕ](const f:𝔹^n → mfree 𝔹^n,xs:𝔹^n) mfree{
    with f(xs):=xs{
        if xs==vector(n,0){phase(π);}
    }
    return xs;
}

def amplitude_estimation[shots:!ℕ][n:!ℕ,m:!ℕ](const f:𝔹^n → mfree 𝔹^n,const g:𝔹^n → mfree 𝔹^n){
    def Q(xs:𝔹^n) mfree{
        xs := projector_reflection(g,xs);
        return projector_reflection(f,xs);
    }
    t := QPE[shots][n,m](Q,f);
    return abs(cos(π*t));
}

def r(qs:𝔹^1){
    qs[0] := rotY(π/3,qs[0]);
    return qs;
}

def identity(qs:𝔹^1){
    //qs[0] := X(qs[0]);
    return qs;
}

def main(){
    return amplitude_estimation[10][1,5](identity,r);
}
