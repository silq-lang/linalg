import phase_estimation.QPE;
import block_encodings.pauli_LCU;
import Amplitude_Amplification.post_selection;
import primitives.trotter;

def HHL_data[κ:!ℝ,m:!ℕ][n:!ℕ](const A:(!ℝ^(2^n))^(2^n)) qfree{
    assert(n>=1 && κ>=1 && m>=2);
    for j in [0..2^n){for k in [0..j){assert(A[j][k]==A[k][j]);}}
    count := 0:!ℕ; coef := []; index := [];
    for r in [0..2^n){
        for s in [0..2^n){
            c := creal(wh_coefficient(dup(A),r,s));
            if c!=0{coef := coef~[c];index := index~[(r,s)];count += 1;}
        }
    }
    angles := vector(2^m,π:!ℝ);
    // Signed reciprocal of lambda=4*j/2^m, extended linearly inside the gap.
    for j in [1..2^(m sub 1)){
        a := κ*4*j/(2^m); if a>1{a = 1/a;}
        angles[j] = 2*acos(a); angles[2^m sub j] = 2*π-angles[j];
    }
    return (count,coef,index,angles);
}

// 1/kappa <= |lambda(A)| <= 1; start anc at zero and postselect all its bits zero.
def HHL[κ:!ℝ,m:!ℕ,steps:!ℕ][n:!ℕ](const A:(!ℝ^(2^n))^(2^n))(anc:𝔹^(m+1),qs:𝔹^n) mfree{
    assert(steps>=1);
    data := HHL_data[κ,m][n](A); coef := data[1] coerce !ℝ^data[0]; index := data[2] coerce (!ℕ^2)^data[0];
    def U(xs:𝔹^n) mfree:𝔹^n{return trotterization[n,data[0]](xs,coef,index,-π/2,steps);}
    (flag:𝔹^1)~(anc:𝔹^m) := anc;
    for j in [0..m){anc[j] := H(anc[j]);}
    (anc,qs) := QPE_coherent(U,anc,qs);
    for j in [0..2^m){
        if (anc as uint[m])==j{flag[0] := rotY(data[3][j],flag[0]);}
    }
    QPE_coherent(U,anc,qs) := (anc,qs);
    for j in [0..m){anc[j] := H(anc[j]);}
    return (flag~anc,qs);
}

def prepare_one(qs:𝔹^1) mfree{qs[0] := X(qs[0]);return qs;}

// A^-1 |1>, normalized: (|0> + 3|1>)/sqrt(10).
def main(){
    A := [[3/4,-1/4],[-1/4,3/4]] coerce (!ℝ^2)^2;
    return post_select[1,4](HHL[2,3,1][1](A),prepare_one);
}