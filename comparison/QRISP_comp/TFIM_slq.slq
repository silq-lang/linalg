import comparison.QRISP_comp.pauli_lcu;

// Plain PREP-SELECT-UNPREP block encoding of
// H = -0.25 Z_0 Z_1 + 0.5 X_0 + 0.5 X_1.
def TFIM[J:!ℝ,h:!ℝ][n:!ℕ,m:!ℕ](anc:𝔹^m,qs:𝔹^n) mfree:𝔹^m×𝔹^n{
    assert(n>1);
    coef := vector(n sub 1,J)~vector(n,h);
    (ind_z, ind_x) := (
        [(0:!ℕ,3*2^k) for k in [0..n sub 1)],
        [(2^k,0:!ℕ) for k in [0..n)]
    );
    return pauli_LCU[m,n,n sub 1 + n coerce !ℕ](anc,qs,ind_z~ind_x,coef);
}

def main(){
    qs := 0:uint[2] as 𝔹^2;
    // Generic operand, so the compiler cannot specialize to a known |00>.
    qs[0] := rotY(π/7,qs[0]);
    qs[1] := rotY(π/9,qs[1]);
    return TFIM[-sqrt(0.25),sqrt(0.5)][2,2](0:uint[2] as 𝔹^2,qs);
}
