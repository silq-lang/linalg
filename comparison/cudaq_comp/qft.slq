// Five-qubit QFT benchmark matching cudaq_algorithms.primitives.qft.

def QFT[n:!ℕ](qs:𝔹^n) mfree:𝔹^n{
    for k in [0..n div 2){(qs[k],qs[n-k-1]):=(qs[n-k-1],qs[k]);}
    for k in [0..n){
        qs[k] := H(qs[k]);
        for l in [k+1..n){if qs[k]&&qs[l]{phase(2·π·2^(k-l-1));}}
    }
    return qs;
}

def main():𝔹^5{
    qs := 0:uint[5] as 𝔹^5;
    for j in [0..5){
        qs[j] := rotY((j+1)*π/11,qs[j]);
        qs[j] := rotZ((j+1)*π/13,qs[j]);
    }
    return QFT(qs);
}
