//import primitves.list_op;

def gray_scalew(N:!ℕ){
    // Lists binary-reflected Gray codes with the initial zero omitted.
    ord := [];
    for k in [1..N){
        ord := ord~[k ⊕ floor(k/2)];
    }
    return ord coerce !ℕ^(N-1 coerce !ℕ);
}

def walsh_function(j:!ℕ,x:!ℝ){
    // Evaluates the jth Walsh function at the binary fraction x.
    if j==0{
        n := 0:!ℕ;
    }else{
        n := floor(log(j)/log(2))+1 coerce !ℕ;
    }
    b := [];
    for _ in [0..n){
        x *= 2;
        b := b~[floor(x)];
        x -= floor(x);
    }
    j := j as !uint[n] as !𝔹^(n);
    s := 0:!ℕ;
    for i in [0..n){
        s += j[i]*b[i];
    }
    s %= 2;
    if s==0{
        return 1;
    }else{
        return -1;
    }
}

def walsh_coefficient[m:!ℕ](j:!ℕ,t:!ℝ^m){
    // Computes one discrete Walsh coefficient of the phase table.
    a := 0:!ℝ;
    for k in [0..m){
        a += t[k]*walsh_function(j,k/m);
    }
    return a/m;
}

def groups(N:!ℕ){
    // Groups nonzero Gray-code labels by their highest set bit.
    v := gray_scalew(N);
    G := [[1]];
    g := [];
    for i in [1..(N sub 1)){
        n1 := floor(log(v[i])/log(2))+1 coerce !ℕ;
        n2 := floor(log(v[i-1])/log(2))+1 coerce !ℕ;
        if (n1 != n2)&&(n2 != 1){
            G := G~[g];
            g := [];
        }
        g := g~[v[i]];
    }
    G := G~[g];
    return G;
}

def c_cont(N:!ℕ){
    // Selects CNOT controls from successive labels in each Gray-code group.
    n := floor(log(N)/log(2)) coerce !ℕ;
    G := groups(N);
    c := [0];
    for i in [1..n){
        for j in [0..2^i){
            if j=0{
                a := 0;
                b := 2^i - 1;
            }else{
                a := j;
                b := j-1;
            }
            c := c~[log(G[i][a] ⊕ G[i][b])/log(2) coerce !ℕ];
        }
    }
    return c coerce !ℕ^(N-1 coerce !ℕ);
}

def walsh_phases[n:!ℕ,k:!ℕ](qs:𝔹^n,angles:!ℝ^k,ord:!ℕ^k,cont:!ℕ^k) mfree{
    // Applies ordered Walsh rotations and their Gray-code CNOT updates.
    for i in [0..k){
        if ord[i]=0{if angles[i] != 0{phase(angles[i]);}}
        else if ord[i]=1{
            if angles[i] != 0{qs[n sub 1] := rotZ(-2*angles[i],qs[n sub 1]);}
        }
        else{
            j := floor(log(ord[i])/log(2))+1 coerce !ℕ;
            control := n sub 1 sub cont[i] coerce !ℕ;
            target := n sub j;
            assert(control < n && target < n && control != target);
            (left:𝔹^target)~(pivot,)~(right:𝔹^(n sub (target+1))) := qs;
            if control < target{
                pivot := CNOT(left[control],pivot);
            }else{
                pivot := CNOT(right[control sub (target+1)],pivot);
            }
            if angles[i] != 0{pivot := rotZ(-2*angles[i],pivot);}
            qs := left~(pivot,)~right;
        }
    }
    return qs;
}

def walsh_hadamard[n:!ℕ,m:!ℕ,k:!ℕ](qs:𝔹^n,t:!ℝ^m,ord:!ℕ^k,cont:!ℕ^k) mfree{
    // Expands the phase table in Walsh functions and applies the selected terms.
    angles := vector(k,0:!ℝ);
    for i in [0..k){angles[i] = walsh_coefficient(ord[i],t);}
    return walsh_phases(qs,angles,ord,cont);
}

def walsh_hadamard_parallel[n:!ℕ,m:!ℕ](qs:𝔹^n,t:!ℝ^m,p:!ℕ) mfree{
    // Splits the Walsh phase sequence across p copied registers.
    ord := (0,)~gray_scalew(m);
    cont := (0,)~c_cont(m);
    xs := vector(p,qs);
    k := floor(m/p) coerce !ℕ;
    for i in [0..p){
        xs[i] := walsh_hadamard(xs[i],t,ord[k*i..(k*i+k)],cont[k*i..(k*i+k)]);
    }
    forget(xs=vector(p,qs));
    return qs;
}

def main(){
    // Demonstrates a two-qubit Walsh phase decomposition in two segments.
    v := [π/3,-π,-2*π,π/2] : !ℝ^4;
    qs := 1:uint[2] as 𝔹^2;
    qs[0] := H(qs[0]);
    return walsh_hadamard_parallel(qs,v,2);
}
