// QROAM table lookup of d words of M bits, block size k.
// Ref: Berry, Gidney, Motta, McClean, Babbush, arXiv:1902.02134, Appendices B and C.

// QROM: XOR f(k·i+l) into qs when the control equals i.
def data_lookup[M:!ℕ](const f:!ℕ → lifted !𝔹^M)[m:!ℕ,n:!ℕ](const control:𝔹^m,k:!ℕ,l:!ℕ,qs:𝔹^n) qfree{
	for i in [0..2^m){
		selected := i == (control as uint[m]);
		r := f(k*i+l);
		for j in [0..M){if r[j]{qs[j] := CNOT(selected,qs[j]);}}
		forget(selected=i == (control as uint[m]));
	}
	return qs;
}

// Swap register i into position 0 when the control equals i.
def cont_swap[k:!ℕ,m:!ℕ,n:!ℕ](const control:𝔹^m,qs:(𝔹^n)^k) qfree{
	for i in [0..2^m){
		if i == (control as uint[m]){(qs[0],qs[i]) := (qs[i],qs[0]);}
	}
	return qs;
}

// Compute (App. B): address = h·k+l; load the k words of block h, then swap word l to r[0].
def qroam_comp[M:!ℕ](const f:!ℕ → lifted !𝔹^M)[m:!ℕ](address:𝔹^m,k:!ℕ) qfree{
	r := vector(k,vector(M,0:𝔹));
	ml := floor(log₂(k)) coerce !ℕ;
	(l:𝔹^ml)~(h:𝔹^(m sub ml coerce !ℕ)) := address;
	for j in [0..k){r[j] := data_lookup(f)(h,k,j,r[j]);}
	r := cont_swap[k,ml,M](l,r);
	return (l~h,r);
}

def bitwise_dotprod[M: !N](x: !uint[M], y: !uint[M]) lifted: !B {
	r := 0;
	for i in 0..M {
		r xorb= x[i] & y[i];
	}
	return r;
}

// Addresses that need a phase fixup, from the X-measurement results m (App. C).
def negate_set[M: !ℕ](const f: !ℕ !→ lifted !𝔹^M)[k: !ℕ](m: !uint[M]^k, d: !ℕ) lifted: !B^d{
	def perm(l:!ℕ, s:!ℕ) lifted{
		if s = 0 {return l;}
		if s = l {return 0;}
		return s;
	}
	S := vector(d, 0:!B);
	for j in [0..d) {
		sum := 0:!𝔹;
		h := j div k;
		l := (j - h*k) coerce !ℕ;
		for s in [0..k) {
			idx := h*k + perm(l, s);
			assert(idx<d);
			sum ⊕= bitwise_dotprod(m[s], f(idx) as !uint[M]);
		}
		S[j] = sum;
	}
	return S;
}

// Fixup bits for addresses 2j and 2j+1.
def fixup_table[S: !B[]](j: !ℕ) lifted: !𝔹^2{
	return (S[2*j], S[2*j+1]);
}

// Low address bits to a one-hot register.
def binary2unary[n:!ℕ](const qs:𝔹^n) lifted{
	xs := 1:uint[2^n] as 𝔹^(2^n);
	for j in [0..n){
		m := 2^j;
		for k in [0..m){
			if qs[j]{
				(xs[k],xs[k+m]) := (xs[k+m],xs[k]);
			}
		}
	}
	return xs;
}

// Undo binary2unary with X measurements and Z fixups.
def unary2binary[n:!ℕ](const qs:𝔹^n,xs:𝔹^(2^n)){
	// Recursive on n: the register width depends on the level.
	if n=0{(x,) := xs coerce 𝔹^1; forget(x=1:𝔹); return;}
	m := 2^(n sub 1);
	(lo:𝔹^m)~(hi:𝔹^m) := xs coerce 𝔹^(m+m);
	for k in [0..m){lo[k] := CNOT(hi[k],lo[k]);}
	for k in [0..m){hi[k] := H(hi[k]);}
	r := measure(hi);
	for k in [0..m){if r[k]&&qs[n sub 1]{lo[k] := Z(lo[k]);}}
	unary2binary[n sub 1](qs[0..n sub 1],lo coerce 𝔹^(2^(n sub 1)));
}

// Uncompute (App. C): measure the outputs in the X basis, then apply phase fixups on the one-hot register.
def qroam_uncomp[M:!ℕ](const f: !ℕ !→ lifted !𝔹^M)[m:!ℕ,k:!ℕ](address:𝔹^m,qs:(𝔹^M)^k,d:!ℕ){
    // Measure each output immediately after H to avoid 2^(k*M) transient
    // simulator branches. Measurements on distinct bits commute.
    def measure_x_reset(q:𝔹):𝔹×!𝔹{
        bit := measure(H(q));
        return (0:𝔹,bit);
    }
    r := vector(k,vector(M,0:!𝔹));
    for i in [0..k){
        for j in [0..M){
            (qs[i][j],bit) := measure_x_reset(qs[i][j]);
            r[i][j] = bit;
        }
    }
    forget(qs=vector(k,vector(M,0:𝔹)));
    def fixup(j:!ℕ) lifted:!𝔹^2{
        result := (0:!𝔹,0:!𝔹);
        for out in [0..2){
            entry := 2*j+out; assert(entry<d);
            h := entry div k; l := entry%k; parity := 0:!𝔹;
            for s in [0..k){
                index := s;
                if s=0{index=l;}else{if s=l{index=0;}}
                word := f(h*k+index);
                for bit in [0..M){
                    if word[bit]{parity ⊕= r[s][bit];}
                }
            }
            result[out] = parity;
        }
        return result;
    }
    ml := floor(log₂(k)) coerce !ℕ;
    (l:𝔹^ml)~(h:𝔹^(m sub ml coerce !ℕ)) := address;
    xs := binary2unary[ml](l);
    for i in [0..k){xs[i] := H(xs[i]);}
    for j in [0..k div 2){(xs[2*j],xs[2*j+1]) := data_lookup(fixup)(h,k div 2,j,(xs[2*j],xs[2*j+1]));}
    for i in [0..k){xs[i] := H(xs[i]);}
    unary2binary(l,xs);
    return l~h;
}

// Example table: 3-bit address, 2-bit words.
def table(p:!ℕ) lifted:!𝔹^2{
	assert(p<8);
	pb := p as !uint[3];
	return (pb[0] ⊕ pb[2],pb[1]);
}

// Example: lookup with k=2, then uncompute; returns the address.
def main(){
	control := 0:uint[3] as 𝔹^3;
	for j in [0..3){control[j] := H(control[j]);}
	(address,qs) := qroam_comp[2](table)[3](control,2);
	return qroam_uncomp[2](table)[3,2](address,qs,8);
}
