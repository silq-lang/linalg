import primitives.list_op;
import arithmetic.shift;

// Rotate data about X by 2*acos(v[i]/max|v|) when the control equals i.
def multiplexed_rotX[N:!ℕ,D:!ℕ](const d:𝔹^N,data:𝔹,v:!ℝ^D) mfree{
	norm_max := max(abs_list(v));
	for i in [0..D){
		if i == (d as uint[N]){
			φ := 2*acos(v[i]/norm_max);
			data := rotX(φ,data);
		}
	}
	return data;
}

// Apply phase arg(v[i]) when the control equals i.
def multiplexed_phase[N:!ℕ,D:!ℕ](const d:𝔹^N,v:!ℂ^D) mfree{
	for i in [0..D){
		if i == (d as uint[N]){
			phase(carg(v[i]));
		}
	}
}

// Apply lowshift_pow[i] to target when the control equals i.
def multiplexed_adder[N:!ℕ,M:!ℕ](const control:𝔹^N,target:𝔹^M) mfree{
	for i in [0..2^N){
		if i == (control as uint[N]){
			target := lowshift_pow[i](target);
		}
	}
	return target;
}

// Apply f to target i times when the control equals i.
def multiplexed_unitaries[q:qtype,N:!ℕ](const f:q → mfree q,const control:𝔹^N,target:q) mfree{
	for j in [0..2^N){
		if j == (control as uint[N]){
			for k in [0..j){target := f(target);}
		}
	}
	return target;
}

// Rotate target about Y by 2*asin(1/(i*κ)) when the control equals i >= 1.
def multiplexed_rotY[N:!ℕ](const control:𝔹^N,target:𝔹^1,κ:!ℝ) mfree{
	for j in [1..2^N){
		if j == (control as uint[N]){
			θ := 2*asin(1/(j*κ));
			target[0] := rotY(θ,target[0]);
		}
	}
	return target;
}