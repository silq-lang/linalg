// Sum of a real list.
def sum[N:!ℕ](t:!ℝ^N) qfree{
	s := 0:!ℝ;
	for i in [0..N){
		s += t[i];
	}
	return s;
}

// Negate each entry.
def minus[N:!ℕ](t:!ℝ^N){
	v := [];
	for i in [0..N){
		v := v~[-t[i]];
	}
	return v coerce !ℝ^N;
}

// Absolute value of each entry.
def abs_list[N:!ℕ](t:!ℝ^N){
	v := [];
	for i in [0..N){
		v := v~[abs(t[i])];
	}
	return v coerce !ℝ^N;
}

// Square root of the magnitude of each entry.
def sqrt_list[N:!ℕ](t:!ℂ^N){
	v := [];
	for i in [0..N){
		v := v~[sqrt(cabs(t[i]))];
	}
	return v coerce !ℝ^N;
}

// asin of each entry after dividing by the largest magnitude.
def arcsin[N:!ℕ](t:!ℝ^N){
	maxt := max(abs_list(t));
	v := [];
	for i in [0..N){
		v := v~[asin(t[i]/maxt)];
	}
	return v coerce !ℝ^N;
}

// Entrywise sum a + b.
def vadd[N:!ℕ](a:!ℂ^N,b:!ℂ^N):!ℂ^N{
	r := vector(N,0);
	for i in [0..N) { r[i]=a[i]+b[i]; }
	return r;
}

// Scale a by c.
def vscale[N:!ℕ](c:!ℂ,a:!ℂ^N):!ℂ^N{
	r := vector(N,0);
	for i in [0..N) { r[i]=c·a[i]; }
	return r;
}

// Reverse and conjugate a.
def sharp[N:!ℕ](a:!ℂ^N):!ℂ^N{
	r := vector(N,0);
	for i in [0..N) { r[i]=conj(a[N-1-i]); }
	return r;
}
