// Hadamard column
def H_n[n:!ℕ](xs:𝔹^n){
	for i in [0..n){ xs[i] := H(xs[i]); }
	return xs;
}

// Write N = 2^k·L with L odd; returns (k,L).
def decomp(N:!ℕ){
	(k,L):=(0,N);
	while (L&1)=0 { L div=2; k+=1; }
	return (k,L);
}

// Uniform superposition over |0>,...,|N-1> on n = ceil(log2 N) qubits.
def uniform_superposition[N:!ℕ][n:!ℕ](qs:𝔹^n) mfree:𝔹^n{
	assert(n=floor(log(N-1)/log(2))+1);
	(k,L) := decomp(N);
	(a:𝔹^k)~(b:𝔹^(n sub k)) := qs;
	b := H_n(b);
	φ := acos(1-2^(n-k-1)/L);
	if (b as uint[n sub k])<L { phase(φ); }
	with b:=H_n(b) do if (b as uint[n sub k])=0{ phase(φ); }
	phase(-(φ+π)/2);
	return H_n(a)~b coerce 𝔹^n;
}

def main(){return uniform_superposition[10][4](0:uint[4] as 𝔹^4); }