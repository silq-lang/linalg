import primitives.fft;
import GQSVT.gqsp_angles;
import opt.mcz;
import block_encodings.block_subroutines;

def R(θ:!ℝ,φ:!ℝ)(anc:𝔹):𝔹{
	with anc:=rotZ(φ,anc){anc:=rotY(θ,anc);}
	return anc;
}

def gqsp[k:!ℕ][d:!ℕ](θs:!ℝ^(d+1),φs:!ℝ^(d+1),ρ:!ℝ)[n:!ℕ,m:!ℕ](const f:𝔹^1 × 𝔹^m × 𝔹^n → mfree 𝔹^1 × 𝔹^m × 𝔹^n)(anc:𝔹^(m+1),qs:𝔹^n)mfree:𝔹^(m+1)×𝔹^n{	
    (flag:𝔹^1)~(anc:𝔹^m) := anc; 
	flag[0]:=R(θs[0],φs[0])(flag[0]);
	for j in [1..d-k+1){
		with X(flag[0]):=flag[0]{(flag,anc,qs):=f(flag,anc,qs);}
		flag[0]:=R(θs[j],φs[j])(flag[0]);
	}
    for j in [d-k+1..d+1){
        (flag,anc,qs):=reverse(f)(flag,anc,qs);
		flag[0]:=R(θs[j],φs[j])(flag[0]);
    }
	phase(ρ);
	return (flag~anc,qs);
}

def chebyshev_coef[d:!ℕ](p:!ℂ^(d+1))qfree{
    a := vector(d+1,0);
    pow2 := 1;
    a[0] = 2*p[0];
    for k in [1..d+1){
        fac := p[k] / pow2;jm := k;jp := 1;
        for j in [k..-2..-1){
            a[j] += fac;fac *= jm / jp;
            jm -= 1;jp += 1;
        }
        pow2 *= 2
    }   
    a[0] /= 2;
    return a;
}

def poly_cond[N:!ℕ][d:!ℕ](p:!ℂ^(d+1)){
    ok := 1;
    for j in 0..N {
        x := -1 + 2*j/N;
        val := cabs(poly_eval(p)(x));
        ok &= (val <= 1);
    }
    return ok;
}

def bound[N:!ℕ][d:!ℕ](p:!ℂ^(d+1)){
    ps:=fft(pad[N](p,0));
    M := 0:!ℂ;
    for j in [0..d+1){M += cabs(ps[j]);}
    g1 := log(sin(1/2))/log(1/2);
    t := 4*log(2*d^2)+sqrt(4+4*log(2*d^2)+2*(log(2*d^2))^2);
    return M*(1+abs(cimag(p[0]))+g1*t/π);
} 

def gqet[k:!ℕ][d:!ℕ](θs:!ℝ^(d+1),φs:!ℝ^(d+1),λ:!ℝ)[n:!ℕ,m:!ℕ](const f:𝔹^1 × 𝔹^m × 𝔹^n → mfree 𝔹^1 × 𝔹^m × 𝔹^n)(anc:𝔹^(m+1),qs:𝔹^n)mfree:𝔹^(m+1)×𝔹^n{
    (flag:𝔹^1)~(anc:𝔹^m) := anc; 
	flag[0]:=R(θs[0],φs[0])(flag[0]);
	for j in [1..d-k+1){
		with X(flag[0]):=flag[0]{(flag,anc,qs):=f(flag,anc,qs);}
        (flag:𝔹^1)~(anc:𝔹^m) := omcz(flag~anc); 
		flag[0]:=R(θs[j],φs[j])(flag[0]);
	}
    for j in [d-k+1..d+1){
        flag[0] := X(flag[0]);
        (flag:𝔹^1)~(anc:𝔹^m) := omcz(flag~anc); 
        flag[0] := X(flag[0]);
        (flag,anc,qs):=reverse(f)(flag,anc,qs);
		flag[0]:=R(θs[j],φs[j])(flag[0]);
    }
	phase(λ);
	return (flag~anc,qs);
}

def gqsvt[k:!ℕ][d:!ℕ](θs:!ℝ^(d+1),φs:!ℝ^(d+1),λ:!ℝ)[n:!ℕ,m:!ℕ](const f:𝔹^2 × 𝔹^m × 𝔹^n → mfree 𝔹^2 × 𝔹^m × 𝔹^n)(anc:𝔹^(m+2),qs:𝔹^n)mfree:𝔹^(m+2)×𝔹^n{
    (flag:𝔹^2)~(anc:𝔹^m) := anc; 
	flag[0]:=R(θs[0],φs[0])(flag[0]);
	for j in [1..d+1){
		//if flag[0]=0{flag[1] := X(flag[1]);}
        flag[0] := X(flag[0]);flag[1] := X(flag[1]);
        (flag,anc,qs):=f(flag,anc,qs); 
        flag[0] := X(flag[0]);flag[1] := X(flag[1]);
        (flag:𝔹^2)~(anc:𝔹^m) := omcz(flag~anc); 
        flag[0] := X(flag[0]);
        (flag,anc,qs):=reverse(f)(flag,anc,qs); 
        flag[0] := X(flag[0]);flag[1] := X(flag[1]);
        (flag:𝔹^2)~(anc:𝔹^m) := omcz(flag~anc);
        flag[1] := X(flag[1]);
	}
	phase(λ);
	return (flag~anc,qs);
}