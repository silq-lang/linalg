import arithmetic.shift;
import GQSVT.func_approx;
import GQSVT.gqsp_angles;
import GQSVT.matrix_poly;
import block_encodings.symtwobytwo;

e := 2.71828182845904523536;

def QET[k:!ℕ][d:!ℕ](θs:!ℝ^(d+1),φs:!ℝ^(d+1),λ:!ℝ)[n:!ℕ,m:!ℕ,r:!ℕ](const f:𝔹^m × 𝔹^n → mfree 𝔹^m × 𝔹^n)(anc:𝔹^(r+m+1),qs:𝔹^n)mfree:𝔹^(r+m+1)×𝔹^n{
    assert(r=floor(log₂(d+1)));
    def regularized_f(ancilla:𝔹^(r+m),xs:𝔹^n) mfree:𝔹^(r+m)×𝔹^n{
        (anc_d:𝔹^r)~(anc_m:𝔹^m) := ancilla;
        (anc_m,xs) := f(anc_m,xs);
        if anc_m!=vector(m,0){anc_d := upper_shift(anc_d);}
        return (anc_d~anc_m,xs);
    }
    return gqsp[k][d](θs,φs,λ)(regularized_f)(anc,qs);
}

def degree(t:!ℝ,α:!ℝ,ϵ:!ℝ) lifted:!ℕ{return ceil(0.5*(e*α*abs(t)/2+(log(4/5/ϵ))/log(e+2*log(4/5/ϵ)/e/abs(t)/α))) coerce !ℕ;}

def factorial(n:!ℕ){result := 1:!ℕ; for j in [1..n+1){result *= j;} return result;}

def exp(n:!ℕ,α:!ℝ,t:!ℝ) ⇒ [((t*α)^k)/factorial(k) for k in [0..n+1)];

def exp_inv(n:!ℕ,α:!ℝ,t:!ℝ) ⇒ [t*((t*α)^k)/factorial(k+1) for k in [0..n+1)];

def ode_solver[n:!ℕ,m:!ℕ](const f:𝔹^m × 𝔹^n → mfree 𝔹^m × 𝔹^n,const U0:𝔹^n → mfree 𝔹^n,const Ub:𝔹^n → mfree 𝔹^n)(t:!ℝ,α:!ℝ,ϵ:!ℝ) mfree{
    d := 2*degree(t,α,ϵ); C := 1.05*e^(t*α); qs := 0:uint[n] as 𝔹^n;
    p1 := exp(d,α,t); p2 := exp_inv(d,α,t); for j in [0..d+1){p1[j] /= C; p2[j] /= C;}
    q1 := complement[d](p1,1e-8); assert(is_complement[num_samples(d,1e-8)][d](p1,q1,1e-8));
    q2 := complement[d](p2,1e-8); assert(is_complement[num_samples(d,1e-8)][d](p2,q2,1e-8));
	(θ1,φ1,λ1):=gqsp_compute_angles[d](p1,q1); (θ2,φ2,λ2):=gqsp_compute_angles[d](p2,q2);
    r := floor(log₂(d+1)) coerce !ℕ; anc := 0:uint[r+m+1] as 𝔹^(r+m+1); flag := H(0);
    if !flag{qs := U0(qs);}else{qs := Ub(qs);}
    if !flag{(anc,qs) := QET[0][d](θ1,φ1,λ1)[n,m,r](f)(anc,qs);}else{(anc,qs) := QET[0][d](θ2,φ2,λ2)[n,m,r](f)(anc,qs);}
    flag := H(flag); anc := anc coerce 𝔹^(m+2*floor(log₂(ceil(0.5*(e*α*abs(t)/2+(log(4/5/ϵ))/log(e+2*log(4/5/ϵ)/e/abs(t)/α)))+1)) coerce !ℕ);
    return ((flag,)~anc,qs);
}

def main(){
    def twosym(anc:𝔹^2,xs:𝔹^1) mfree{
        return twosym_block(anc,xs,1/4,-1);
    }
    def g_x0(xs:𝔹^1) mfree{
        xs[0] := X(xs[0]);
        return xs;
    }
    def g_b(xs:𝔹^1) mfree{
        xs[0] := H(xs[0]);
        return xs;
    }
    return ode_solver[1,2](twosym,g_x0,g_b)(π/4,2,1e-5);
}
