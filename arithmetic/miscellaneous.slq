import arithmetic.CQ_adder;
import arithmetic.QQ_adder;
import arithmetic.QQ_mult;

// Map: |c,x> -> |c,-x mod p> if c=1, otherwise unchanged.
def c_neg_modp[p:!ℕ][n:!ℕ](const ctrl:𝔹,x:𝔹^n){
    assert(p>2); assert(p>=(2^(n sub 1))); assert(p<(2^n));
    ext := 0:𝔹; if ctrl{if (x as uint[n])!=0{ext := X(ext);}}
    for j in [0..n){x[j] := CNOT(ext,x[j]);}
    x := c_QC_adder[n](ext,0:𝔹,x,p+1);
    if ctrl{if (x as uint[n])!=0{ext := X(ext);}}
    forget(ext=0);
    return x;
}

// Apply the square while its multiplication history is still available,
// then clear that history once. No copied square and second multiplication.
// Map: |c,x,y> -> |c,x-c*y^2 mod p,y>.
def square_minus_modp[p:!ℕ][n:!ℕ](const ctrl:𝔹,x:𝔹^n,y:𝔹^n){
    return square_sub_modp[1:!𝔹][p][n](ctrl,x,y);
}

// Map: |c,x,y> -> |c,x-c*y^2 mod p,y>, with selected reduction.
def square_sub_modp[montgomery:!𝔹][p:!ℕ][n:!ℕ](const ctrl:𝔹,x:𝔹^n,y:𝔹^n){
    f := (2^n-p) coerce !ℕ;
    h := field_bits(f)+1;
    // Two exact folds leave a value below 2p; one subtraction canonicalizes it.
    if !montgomery && 2^n+2^h*f<2*p{
        return ordinary_square_sub[p][n](ctrl,x,y);
    }
    w := mult_window[n](); N := montgomery_bits[w][n](); d := N sub n;
    shifts := d; if !montgomery{shifts = N;}
    copy := dup(y);
    (y,copy,garbage,underflow,z) := mult_modp[N,w](p,
        y~vector(d,0) coerce 𝔹^N,copy~vector(d,0) coerce 𝔹^N);
    (z:𝔹^n)~(0:uint[d] as 𝔹^d) := z coerce 𝔹^(n+d);
    factor := (2^shifts)%p;
    length := field_bits(factor);
    bits := factor as !uint[length];
    weight := 0:!ℕ;
    for j in [0..length){if bits[j]{weight += 1;}}
    if 2*(length sub 1)+4*weight < 2*shifts+4{
        // Accumulate the sparse Montgomery correction directly into x.
        for j in [0..length){
            if bits[j]{(z,x) := c_QQ_sub_modp[p][n](ctrl,z,x);}
            if j+1<length{z := double_modp[p][n](z);}
        }
        for j in [1..length){z := half_modp[p][n](z);}
    }else{
        for j in [0..shifts){z := double_modp[p][n](z);}
        (z,x) := c_QQ_sub_modp[p][n](ctrl,z,x);
        for j in [0..shifts){z := half_modp[p][n](z);}
    }
    (y,copy) := unmult_modp[N,w](p,y,copy,garbage,underflow,
        z~vector(d,0) coerce 𝔹^N);
    (y:𝔹^n)~(0:uint[d] as 𝔹^d) := y coerce 𝔹^(n+d);
    (copy:𝔹^n)~(0:uint[d] as 𝔹^d) := copy coerce 𝔹^(n+d);
    for j in [0..n){copy[j] := CNOT(y[j],copy[j]);}
    forget(copy=0:uint[n]);
    return (x,y);
}

// Map: |c,x,y> -> |c,x-c*y^2 mod p,y> via ordinary reduction.
def ordinary_square_sub[p:!ℕ][n:!ℕ](const ctrl:𝔹,x:𝔹^n,y:𝔹^n){
    f := (2^n-p) coerce !ℕ; h := field_bits(f)+1; m := n+h;
    assert(2^n+2^h*f<2*p);
    (y,z) := integer_square[0:!𝔹][n](y,0:uint[2*n] as 𝔹^(2*n));
    (low:𝔹^n)~(high:𝔹^n) := z;
    (high,low) := add_multiple[0:!𝔹][f][n,m](high,low~(0:uint[h] as 𝔹^h) coerce 𝔹^m);
    (low:𝔹^n)~(middle:𝔹^h) := low coerce 𝔹^(n+h);
    (middle,low) := add_multiple[0:!𝔹][f][h,n+1](middle,low~(0,));
    low := c_const_addsub[1:!𝔹][n+1](1:𝔹,low,p);
    (low:𝔹^n)~(sign,) := low;
    low := c_const_addsub[0:!𝔹][n](sign,low,p);
    (low,x) := c_QQ_sub_modp[p][n](ctrl,low,x);
    low := c_const_addsub[1:!𝔹][n](sign,low,p);
    low := c_const_addsub[0:!𝔹][n+1](1:𝔹,low~(sign,),p);
    (middle,low) := add_multiple[1:!𝔹][f][h,n+1](middle,low);
    (low:𝔹^n)~(0,) := low;
    (high,low) := add_multiple[1:!𝔹][f][n,m](high,low~middle coerce 𝔹^m);
    (low:𝔹^n)~(0:uint[h] as 𝔹^h) := low coerce 𝔹^(n+h);
    (y,z) := integer_square[1:!𝔹][n](y,low~high);
    forget(z=0:uint[2*n]);
    return (x,y);
}

// Map: Example: |+>|5> -> (|0,5>+|1,8>)/sqrt(2) for p=13.
def main(){
    ctrl := H(0:𝔹);x := 5:uint[4] as 𝔹^4;
    x := c_neg_modp[13](ctrl,x);
    return (ctrl,x as uint[4]);
}
