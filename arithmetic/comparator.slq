import opt.mcx;

def toffoli(const x:𝔹,const y:𝔹,z:𝔹) qfree{
    if y{if x{z:=X(z);}}
    return z;
}

def QQ_comparator[n:!ℕ](a:𝔹^n,b:𝔹^n,z:𝔹) qfree{
    with{a[0] := X(a[0]); for j in [1..n){a[j] := X(a[j]); a[j] := CNOT(b[j], a[j]);}}
    do{
        z := CNOT(b[n sub 1], z);
        for j in [1..n sub 1){b[n sub j] := CNOT(b[n sub j sub 1], b[n sub j]);}
        for j in [0..n sub 1){b[j + 1] := toffoli(b[j],a[j],b[j + 1]);}
        z := toffoli(b[n sub 1], a[n sub 1], z);
        for j in [0..n sub 1) {b[n sub j sub 1] := toffoli(b[n sub j sub 2],a[n sub j sub 2],b[n sub j sub 1]);}
        for j in [1..n sub 1){b[j + 1] := CNOT(b[j],b[j+1]);}
    }
    return (a,b,z);
}

