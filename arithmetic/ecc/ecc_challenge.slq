import arithmetic.ecc.pingpong;
import arithmetic.ecc.kernels;

// secp256k1 point addition (x,y) += (bx,by) for the ECDSA.Fail challenge:
// finite points with distinct x coordinates (the evaluator excludes the
// others), with the classical tangent slope 3*bx^2/(2*by) supplied in
// `tangent` for the case A=-2B. Each step is one fused kernel of kernels.slq.
//   x := x-bx, y := y-by, y := y/x                  λ = (y-by)/(x-bx)
//   x := x-y^2+3*bx                                 x := bx-x3
//   y := y*x (y := y-tangent, x := 1 if x=0)        λ*(bx-x3)
//   x := bx-x, y := y-by                            (x3,y3)
def challenge_point_add_runtime[p:!ℕ][n:!ℕ](state:𝔹^n×𝔹^n×𝔹^n×𝔹^n×𝔹^n) @noinline{
    (x,y,bx,by,tangent) := state;
    (bx,x) := challenge_field_sub[p][n]((bx,x));
    (by,y) := challenge_field_sub[p][n]((by,y));
    (x,y) := pp_modular_map[0:!𝔹][p][n][pp_rounds[n]()]((x,y));
    (x,y) := challenge_square_sub[p][n]((x,y));
    for j in [0..3){(bx,x) := challenge_field_add[p][n]((bx,x));}
    // A=-2B: x is 0 and λ is the tangent slope; multiply λ-tangent=0 by 1.
    zero := 0:𝔹;
    (x,zero) := challenge_zero_flag[n]((x,zero));
    (zero,tangent,y) := challenge_tangent_sub[p][n]((zero,tangent,y));
    x[0] := CNOT(zero,x[0]);
    (x,y) := pp_modular_map[1:!𝔹][p][n][pp_rounds[n]()]((x,y));
    x[0] := CNOT(zero,x[0]);
    (x,zero) := challenge_zero_flag[n]((x,zero));
    forget(zero=0);
    (bx,x) := challenge_field_rsub[p][n]((bx,x));
    (by,y) := challenge_field_sub[p][n]((by,y));
    return (x,y,bx,by,tangent);
}
